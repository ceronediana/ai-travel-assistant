<div class="container-fluid p-0">
  <div class="position-relative w-100">

    <!-- Hero Image -->
    <%= image_tag "hero.jpg",
      class: "w-100 d-block",
      style: "height: ; object-fit: cover;",
      alt: "Travel destination" %>

    <!-- Dark Overlay -->
    <div class="position-absolute top-0 start-0 w-100 h-100 bg-dark opacity-75"></div>

    <!-- Hero Content -->
    <div class="position-absolute top-50 start-50 translate-middle text-center text-white w-75">

      <h1 class="display-3 fw-bold">TravelGenie</h1>

      <p class="lead">
        Plan your trips, organize your travel ideas, and get
        personalized recommendations with help from the TravelGenie AI.
      </p>

      <%= link_to "Start Planning",
        trips_path,
        class: "btn btn-gradient btn-lg" %>

    </div>

  </div>
</div>
