<h1 class="mb-4">Edit your trip item!</h1>

<%= simple_form_for [@trip, @trip_item] do |f| %>
  <%= f.input :name,label: "Item Name", placeholder: "Beach Day" %>
  <%= f.input :notes,label: "Notes", placeholder: "Pack beach essentials" %>

  <%= f.submit "Edit Trip Item", class: "btn btn-success mt-2" %>
<% end %>

<%= link_to "Back trip", trip_path(@trip), class: "btn btn-secondary mt-4" %>
