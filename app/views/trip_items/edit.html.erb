<div class="container mt-5 create-trip-page">
  <div class="trips-banner">
    <h1 class="mb-0">Edit Your Trip Item! ✏️</h1>
    <p>Update the details of something in your itinerary.</p>
  </div>

  <div class="app-form-card">
    <%= simple_form_for @trip_item, html: { class: "app-form" } do |f| %>
      <%= f.input :name,
          label: "Item Name",
          placeholder: "Beach Day" %>

      <%= f.input :notes,
          label: "Notes",
          placeholder: "Pack beach essentials" %>

      <%= f.input :tag_list,
          as: :check_boxes,
          collection: ["Accommodations", "Food", "Activities", "Things to pack"] %>

      <div class="app-form-actions">
        <%= f.submit "Save Changes", class: "btn btn-gradient" %>
        <%= link_to "Back to Trip", trip_path(@trip), class: "btn btn-light-blue" %>
      </div>
    <% end %>
  </div>
</div>
