<h1 class="mb-4">Add an item to your trip!</h1>

<%= simple_form_for [@trip, @trip_item] do |f| %>
  <%= f.input :name,label: "Item Name", placeholder: "Beach Day" %>
  <%= f.input :notes,label: "Notes", placeholder: "Pack beach essentials" %>

  <%= f.submit "Add Item to Trip", class: "btn btn-success mt-2" %>
<% end %>

<%= link_to "Back to all trips", trips_path, class: "btn btn-secondary mt-4" %>
