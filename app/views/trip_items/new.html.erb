<div class="container mt-5 create-trip-page">
  <div class="trips-banner">
    <h1 class="mb-0">Add an Item to Your Trip! ✈️</h1>
    <p>Save something special to your itinerary.</p>
  </div>

  <div class="app-form-card">
    <%= simple_form_for [@trip, @trip_item], html: { class: "app-form" } do |f| %>
      <%= f.input :name,
          label: "Item Name",
          placeholder: "Beach Day" %>

      <%= f.input :notes,
          label: "Notes",
          placeholder: "Pack beach essentials" %>

      <%= f.input :tag_list,
          as: :check_boxes,
          collection: ["Accommodations", "Food", "Activities", "Things to pack"] %>

      <div class="app-form-actions">
        <%= f.submit "Add Item to Trip", class: "btn btn-gradient" %>
        <%= link_to "Back to all trips", trips_path, class: "btn btn-light-blue" %>
      </div>
    <% end %>
  </div>
</div>
