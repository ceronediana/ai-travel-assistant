<h1 class="mb-4">Create a New Trip!</h1>

<%= simple_form_for @trip do |f| %>
  <%= f.input :name,label: "Trip Name", placeholder: "Best Trip Ever" %>
  <%= f.input :destination,label: "Destination", placeholder: "Wonderland" %>
  <%= f.input :start_date, as: :date, html5: true, label: "Start Date" %>
  <%= f.input :end_date, as: :date, html5: true, label: "End Date" %>
  <%= f.input :image, as: :file, label: "Trip Image", input_html: { accept: "image/*" } %>

  <%= f.submit "Create Trip", class: "btn btn-success mt-2" %>
<% end %>

<%= link_to "Back to all trips", trips_path, class: "btn btn-secondary mt-4" %>
