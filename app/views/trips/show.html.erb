<h1 class="display-3 fw-bold"><%= @trip.name %></h1>
<p>Trip details</p>

<p><%= @trip.destination %></p>
<p><%= @trip.start_date %></p> <p><%= @trip.end_date %></p>

<h5>Here are some highlights</h5>
<%= link_to "Add a trip item!", new_trip_trip_item_path(trip_id: @trip.id), class:"btn btn-success mb-3"%>

<% @trip.trip_items.each do |item| %>
  <div class="card-body d-flex flex-column">
    <h5><%= item.name %></h5>
    <p class="card-text text-muted"><%= item.notes %></p>
  </div>
<% end %>

<%= link_to "Edit Trip", edit_trip_path(@trip), class: "btn btn-primary mb-3" %>

 <%= link_to "Delete Trip", trip_path(@trip), data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}, class: "btn btn-primary mb-3" %>


<%= form_with url: trip_chats_path(@trip) do |f| %>
  <%= f.submit "New Chat", class: "btn btn-primary mb-3" %>
<% end %>

<h5>Chats</h5>

<% if @trip.chats.empty? %>
  <p>No chats yet. Start a new conversation!</p>
<% else %>
  <% @trip.chats.each do |chat| %>
    <p><%= link_to chat.title.presence || "Chat ##{chat.id}", chat_path(chat) %></p>
  <% end %>
<% end %>
