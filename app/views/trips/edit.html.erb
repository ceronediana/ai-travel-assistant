<div class="container mt-5 create-trip-page">
  <div class="trips-banner">
    <h1 class="mb-0">Edit Your Trip ✈️</h1>
    <p>Make changes to your upcoming adventure.</p>
  </div>

  <div class="app-form-card">
    <%= simple_form_for @trip, html: { class: "app-form" } do |f| %>
      <%= f.input :name,
          label: "Trip Name" %>

      <%= f.input :destination,
          label: "Destination",
          placeholder: "Wonderland" %>

      <div class="row">
        <div class="col-md-6">
          <%= f.input :start_date,
              as: :date,
              html5: true,
              label: "Start Date" %>
        </div>

        <div class="col-md-6">
          <%= f.input :end_date,
              as: :date,
              html5: true,
              label: "End Date" %>
        </div>
      </div>

      <%= f.input :image,
          as: :file,
          label: "Trip Image",
          input_html: { accept: "image/*" } %>

      <div class="app-form-actions">
        <%= f.submit "Update Trip", class: "btn btn-gradient" %>
        <%= link_to "Back to all trips", trips_path, class: "btn btn-light-blue" %>
      </div>
    <% end %>
  </div>
</div>
