  <div class="body">
  <div class="trips-banner text-white shadow-lg">
    <h1 class="fw-bold">Here are your trips ✈️</h1>
  </div>

  <div class="row g-3">
    <% @trips.each do |trip| %>
      <div class="col-md-6">
        <div class="card border-0 shadow-sm trip-card">
          <div class="card-body d-flex flex-column">
            <%= link_to trip.name, trip_path(trip), class: "text-decoration-none fs-5 fw-semibold" %>
          </div>
        </div>
      </div>
    <% end %>
  </div>

  <div class="mt-4">
    <%= link_to "Create a new trip", new_trip_path, class: "btn btn-gradient px-4 py-2 text-white fw-semibold rounded-pill" %>
  </div>
</div>
