<div class="trips-banner">
  <h1>Here are your Trips ✈️</h1>

  <%= link_to "Create a new trip", new_trip_path, class: "btn btn-gradient" %>
  </div>
  <% if @trips.empty? %>
    <p>You don't have any trips yet. Create your first trip to get started!</p>
  <% else %>
    <div class="row">
      <% @trips.each do |trip| %>
        <div class="col-md-6 mb-3">
          <div class="card trip-card">

            <% if trip.image.attached? %>
              <%= image_tag trip.image, class: "card-img-top", alt: trip.name %>
            <% end %>

            <div class="card-body">

              <h3><%= trip.name %></h3>

              <p>📍 <%= trip.destination %></p><p>
                📅 <%= trip.start_date %> to <%= trip.end_date %>
              </p>

              <%= link_to "View Trip", trip_path(trip), class: "btn btn-outline" %>

            </div>
          </div>
        </div>
      <% end %>
    </div>
  <% end %>
