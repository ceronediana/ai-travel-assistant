<div class="container mt-4 chat-page">

  <!-- Chat Header -->
  <div class="chat-header">
    <div>
      <h1 id="chat_title">
        <%= @chat.title.presence || "New Chat" %>
      </h1>
      <p>Plan your trip to <%= @chat.trip.destination %> with TravelGenie!</p>
    </div>
  </div>

  <!-- Chat Window -->
  <div class="chat-card">

    <!-- Scrollable Messages -->
    <div id="messages" class="chat-messages">
      <% @chat.messages.each do |message| %>
        <%= render "messages/message", message: message %>
      <% end %>
    </div>

    <!-- Message Input -->
    <div id="new_message_container" class="chat-form-container">
      <%= render "messages/form", chat: @chat, message: @message %>
    </div>

  </div>

  <!-- Chat Actions -->
  <div class="chat-actions">
    <%= link_to "Back to Trip",
        trip_path(@chat.trip),
        class: "btn btn-light-blue" %>

    <%= button_to "Delete Chat",
        chat_path(@chat),
        method: :delete,
        data: { turbo_confirm: "Are you sure you want to delete this chat?" },
        class: "btn btn-danger-soft" %>
  </div>

</div>
