<%= simple_form_for [chat, message], html: { class: "chat-form" } do |f| %>

  <%= f.input :content,
      label: "Start planning!",
      required: true,
      placeholder: "Where do I go?",
      input_html: { rows: 2 } %>

  <%= f.button :submit,
      "Ask TravelGenie",
      class: "btn btn-gradient" %>

<% end %>
